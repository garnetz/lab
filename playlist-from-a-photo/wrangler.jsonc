// A Cloudflare Worker that serves the page in public/ and turns a photo into a playlist at /api/playlist.
// Set your key once with `npx wrangler secret put ANTHROPIC_API_KEY` (or .dev.vars locally).
{
  "name": "playlist-from-a-photo",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // A few photos a minute per visitor keeps the API bill small.
  "ratelimits": [{ "name": "PHOTO_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] }
}
