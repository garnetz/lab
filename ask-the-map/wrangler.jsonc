// A Cloudflare Worker that serves the page in public/ and asks Claude at /api/ask-the-map/*.
// Set your key once with `npx wrangler secret put ANTHROPIC_API_KEY` (or .dev.vars locally).
// Without a key the page still works, ranking trails by the map facts alone.
{
  "name": "ask-the-map",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // Each question is two small calls, so this is about three questions a minute per visitor.
  "ratelimits": [{ "name": "MAP_LIMITER", "namespace_id": "1003", "simple": { "limit": 6, "period": 60 } }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] }
}
